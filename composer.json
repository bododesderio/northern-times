{
  "name": "northern-times/platform",
  "description": "The Northern Times - PHP + PostgreSQL news platform",
  "type": "project",
  "require": {
    "php": "^8.2",
    "vlucas/phpdotenv": "^5.6",
    "symfony/http-foundation": "^7.1",
    "symfony/routing": "^7.1",
    "symfony/http-kernel": "^7.1",
    "ramsey/uuid": "^4.7",
    "dompdf/dompdf": "^2.0",
    "geoip2/geoip2": "^3.3",
    "minishlink/web-push": "^9.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
