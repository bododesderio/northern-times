APP_NAME="The Northern Times"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_DOMAIN=your-domain.com

# Database — use strong, unique credentials in production
DB_HOST=db
DB_PORT=5432
DB_NAME=northern_times
DB_USER=northern
DB_PASS=CHANGE_ME_TO_STRONG_PASSWORD

# Sessions
SESSION_NAME=northern_times_session
SESSION_SECURE=true

# CSRF — generate with: php -r "echo bin2hex(random_bytes(32));"
CSRF_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_STRING

# pgAdmin (optional, remove in production if not needed)
PGADMIN_EMAIL=admin@northerntimes.com
PGADMIN_PASS=CHANGE_ME_TO_STRONG_PASSWORD

# Python Article Extractor
EXTRACTOR_URL=http://extractor:5000
EXTRACTOR_TIMEOUT=15

# Media uploads
MEDIA_PUBLIC_BASE=/uploads
MEDIA_UPLOAD_MAX_MB=100
MEDIA_DEFAULT_FOLDER=Articles

# ── Mail Settings ──────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=CHANGE_ME_TO_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="The Northern Times"

# ── MaxMind GeoIP (free account: https://www.maxmind.com/en/geolite2/signup) ──
MAXMIND_LICENSE_KEY=CHANGE_ME_TO_YOUR_LICENSE_KEY

# ── Error Tracking (optional, https://sentry.io) ──────────────────
# SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456

# ── Branding (optional overrides) ─────────────────────────────────
# BRAND_NAME="My Publication"
# BRAND_LOGO_URL=/uploads/Branding/logo.png
# BRAND_LOGO_DARK_URL=/uploads/Branding/logo-dark.png
# BRAND_FAVICON_URL=/uploads/Branding/favicon.png
# BRAND_ABBREVIATION=MP
