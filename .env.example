APP_NAME="The Northern Times"
APP_VERSION=2.0.0
APP_URL=https://your-domain.com
APP_DOMAIN=your-domain.com    # Used for SSL cert paths and nginx server_name
APP_BOT_NAME=NewsCrawlerBot   # User-Agent name for crawler/webhook/image requests

# ── Django ────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY
DJANGO_SETTINGS_MODULE=config.settings.production

# ── Database ─────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=northern_times
DB_USER=northern
DB_PASS=CHANGE_ME_TO_STRONG_PASSWORD

# ── Redis ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 24 | tr -d '/+='
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ── pgAdmin (optional, remove in production) ─────────────────────
PGADMIN_EMAIL=admin@your-domain.com
PGADMIN_PASS=CHANGE_ME_TO_STRONG_PASSWORD

# AI Article Rewriter (OpenAI API)
REWRITER_ENABLED=true
REWRITER_WORD_TOLERANCE=50
REWRITER_BATCH_SIZE=3
OPENAI_API_KEY=CHANGE_ME_TO_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Crawler settings
CRAWLER_FETCH_TIMEOUT=15
CRAWLER_BATCH_WORKERS=4
CRAWLER_DEDUP_THRESHOLD=0.82
CRAWLER_CLUSTER_THRESHOLD=0.65

# SSL verification for outbound HTTP (crawlers, image downloads, webhooks)
# Set to false only in dev environments with self-signed certs
VERIFY_SSL=true

# Media uploads
MEDIA_PUBLIC_BASE=/uploads
MEDIA_UPLOAD_MAX_MB=100
MEDIA_DEFAULT_FOLDER=Articles

# ── Storage Provider ──────────────────────────────────────────────
# Options: local, s3
# When set to s3, files are uploaded to the configured S3 bucket.
# When set to local, files are stored in storage/uploads/
STORAGE_DRIVER=local

# S3-compatible storage (works with AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO)
# Recommended: Cloudflare R2 (no egress fees, S3-compatible, generous free tier)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=northern-times
S3_REGION=auto
S3_KEY=CHANGE_ME
S3_SECRET=CHANGE_ME
S3_URL=https://cdn.your-domain.com
# Optional: prefix all keys with this path
S3_PATH_PREFIX=uploads

# ── Mail Settings (self-hosted Postfix — no auth on internal network) ──
MAIL_DRIVER=smtp
MAIL_HOST=mail
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="The Northern Times"

# ── DNS Records Required for Mail Delivery ────────────────────────
# Add these DNS records to avoid emails landing in spam:
#
# SPF (TXT record on root domain):
#   your-domain.com  TXT  "v=spf1 ip4:YOUR_SERVER_IP -all"
#
# DKIM (TXT record — get the key from the container after first run):
#   docker exec northern_times_mail cat /etc/opendkim/keys/your-domain.com/default.txt
#   default._domainkey.your-domain.com  TXT  (paste the key)
#
# DMARC (TXT record):
#   _dmarc.your-domain.com  TXT  "v=DMARC1; p=quarantine; rua=mailto:admin@your-domain.com"
#
# PTR (reverse DNS — set via your VPS provider's panel):
#   YOUR_SERVER_IP  PTR  mail.your-domain.com

# ── MaxMind GeoIP (free account: https://www.maxmind.com/en/geolite2/signup) ──
MAXMIND_LICENSE_KEY=CHANGE_ME_TO_YOUR_LICENSE_KEY

# ── Error Tracking (optional, https://sentry.io) ──────────────────
# SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456

# ── Branding (optional overrides) ─────────────────────────────────
# BRAND_NAME="My Publication"
# BRAND_LOGO_URL=/uploads/Branding/logo.png
# BRAND_LOGO_DARK_URL=/uploads/Branding/logo-dark.png
# BRAND_FAVICON_URL=/uploads/Branding/favicon.png
# BRAND_ABBREVIATION=MP
